<?xml version="1.0" encoding="utf-8"?>
<!-- Zayn Play: soft glossy glow disc shown behind the buffering spinner.
     Pulsed (alpha 0.55 -> 1.0) from PlayerView while buffering. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="80dp"
        android:startColor="#80FFFFFF"
        android:centerColor="#33FFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
